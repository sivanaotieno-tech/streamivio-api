# Copy to .env.hovod on the persistent media VM. Never commit the real file.
PORT=3000
UPLOAD_DIR=/data/uploads
WORK_DIR=/data/tmp
APP_URL=https://media-api.example.com
CORS_ORIGIN=https://streamivio.vercel.app
EMBED_FRAME_ANCESTORS="'self' https://streamivio.vercel.app"

# Generate a unique secret with: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Cloudflare R2 / S3-compatible storage
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=streamivio-media
S3_ACCESS_KEY_ID=REPLACE_WITH_BUCKET_ACCESS_KEY
S3_SECRET_ACCESS_KEY=REPLACE_WITH_BUCKET_SECRET
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_PUBLIC_BASE_URL=https://media-assets.example.com
S3_PUBLIC_ACL=false

# Keep cloud billing mode disabled for self-hosting.
# HOVOD_CLOUD is intentionally not set.
