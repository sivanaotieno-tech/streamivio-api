# Streamivio API settings
STREAMIVIO_ALLOWED_ORIGINS=https://streamivio.vercel.app

# Optional self-hosted StreamX metadata adapter.
# Enable only after reviewing every upstream data provider's terms.
STREAMX_API_BASE=
STREAMX_UPSTREAM_TERMS_APPROVED=false\nANILIST_USAGE_APPROVED=false

# Hovod API and trusted media/CDN hostnames (comma-separated hostnames only).
HOVOD_API_URL=
HOVOD_ALLOWED_MEDIA_HOSTS=

# Optional legacy metadata enrichment key; not required for the StreamX adapter.
OMDB_API_KEY=
